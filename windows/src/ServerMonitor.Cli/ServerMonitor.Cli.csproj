<Project Sdk="Microsoft.NET.Sdk">

  <!-- smctl: the whole collection chain with no window, so a real host can be
       polled from a terminal and the JSON diffed against the Go and Swift
       collectors. Not shipped in the installer; it is a development and
       support tool. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ServerMonitor.Cli</RootNamespace>
    <AssemblyName>smctl</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServerMonitor.Core\ServerMonitor.Core.csproj" />
  </ItemGroup>

</Project>
