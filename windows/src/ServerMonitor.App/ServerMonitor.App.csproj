<Project Sdk="Microsoft.NET.Sdk">

  <!-- The shell (macOS side: the ServerMonitor executable target). Everything
       Windows-specific lives here; Core stays portable. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The version in the TFM is the *target*; SupportedOSPlatformVersion
         below is the *minimum*. 19041 (2004) is a conservative target that
         still exposes everything this app calls. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms comes in for the tray icon and the screen-capture helper
         only; no WinForms UI is built. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ServerMonitor.App</RootNamespace>
    <AssemblyName>ServerMonitor</AssemblyName>
    <!-- 1809 is the floor (D8): ConPTY and the in-box OpenSSH client both
         start there. Declared so the platform-compatibility analyser flags a
         call to anything newer, which is otherwise a runtime crash on the
         oldest machine the README says is supported. -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- No WPF-UI, and no H.NotifyIcon — a deliberate departure from D1's
       shopping list, though not from its reasoning.

       D1 chose WPF-UI for three things: a NavigationView sidebar, Mica, and
       ToggleSwitch/ProgressRing, because WPF's own Fluent theme is still
       experimental and lacks them (F6). Of those, Mica is twenty lines of
       DwmSetWindowAttribute (see Platform/Backdrop.cs) and the sidebar is a
       ListBox with a template — while the rest of this app's surface is
       self-drawn anyway, because D6 already decided the gauges and charts
       would be. That left one third-party dependency supplying styling for
       controls we are not using, and R6 flagged exactly that risk.

       The tray icon is WinForms' NotifyIcon, which is first-party, has taken
       a dynamically drawn 16px bitmap since 2002, and needs no wrapper.

       The terminal control (D5) is a different case and its decision stands:
       there is no first-party alternative to write around. -->
  <!-- No CommunityToolkit.Mvvm either, and for a duller reason than WPF-UI:
       nothing here ever used it. There is no view-model layer — the pages
       build their own trees and read MonitorService directly, which
       implements INotifyPropertyChanged by hand — so the package was a
       dependency to keep updated in exchange for nothing. -->
  <ItemGroup>
    <!-- D5. What is actually used from this package is
         Microsoft.Terminal.Wpf.TerminalControl and the native renderer it
         carries; the ConPTY half is for the ssh.exe fallback route and is not
         wired up. Everything that touches it is behind Terminal/TerminalHost,
         per R3. -->
    <PackageReference Include="EasyWindowsTerminalControl" Version="$(TerminalControlVersion)" />
  </ItemGroup>

  <!-- The terminal renderer ships an 85 MB PDB per architecture. Useful to
       whoever debugs Windows Terminal, three times the size of everything
       else we would ever ship, and no help to a crash dump from this app. -->
  <Target Name="DropTerminalRendererSymbols"
          AfterTargets="ResolveReferences"
          BeforeTargets="_CopyFilesMarkedCopyLocal">
    <ItemGroup>
      <ReferenceCopyLocalPaths
          Remove="@(ReferenceCopyLocalPaths)"
          Condition="'%(Filename)%(Extension)' == 'Microsoft.Terminal.Control.pdb'" />
    </ItemGroup>
  </Target>

  <!-- And again for publish, which builds its file list separately: without
       this the 85 MB PDB is what the release zip is mostly made of. -->
  <Target Name="DropTerminalRendererSymbolsOnPublish"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
          Remove="@(ResolvedFileToPublish)"
          Condition="'%(Filename)%(Extension)' == 'Microsoft.Terminal.Control.pdb'" />
    </ItemGroup>
  </Target>

  <!-- UseWindowsForms adds System.Drawing and System.Windows.Forms to the
       implicit usings, and both collide with WPF on the names this app uses
       most: Color, Point, Size, Brush, Pen, Control. Removed here and imported
       explicitly in the two files that actually draw with GDI+ (the tray icon
       and the screen-capture helper), where no WPF type appears. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServerMonitor.Core\ServerMonitor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The controls and helpers are internal on purpose: nothing outside the
         app builds a view. The render tests are the exception, and they are
         the only reason any of this is testable without a desktop session. -->
    <InternalsVisibleTo Include="ServerMonitor.App.Tests" />
  </ItemGroup>

</Project>
