<Window x:Class="ServerMonitor.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ServerMonitor.App.Controls"
        Title="Server Monitor"
        MinWidth="900" MinHeight="600"
        Width="1280" Height="820"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource Brush.Background}">
    <!--
        The sidebar layout the plan calls for (§1): Dashboard / Resources
        (Machines · Identities · SSH keys) / Toolbox (Snippets · Containers) /
        Sessions, matching the macOS build so a screenshot of one is a
        screenshot of the other.

        A ListBox with a template rather than a NavigationView. That is the
        deviation the csproj explains: the rail, the grouping and the selection
        state are a template, and the alternative was a third-party dependency
        supplying styling for controls this app does not use.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- MARK: - Sidebar -->

        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- The brand lockup, as on the web client: the mark, the
                     name, and CONTROL CENTER beneath it. The title bar is the
                     system's, so this is a heading and not a caption; the top
                     margin keeps it clear of the caption buttons.

                     CONTROL CENTER stays English in both languages because it
                     is part of the mark rather than a label — the same reason
                     the web hard-codes it. -->
                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            Margin="16,14,18,10">
                    <controls:BrandMark Edge="30" VerticalAlignment="Center"
                                        Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="AppTitle"
                                   Style="{StaticResource Text.Title}"
                                   Text="Server Monitor" />
                        <TextBlock Style="{StaticResource Text.Tertiary}"
                                   Margin="0,1,0,0"
                                   FontSize="8.5"
                                   Text="CONTROL CENTER" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ListBox x:Name="Nav"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="OnNavigationChanged"
                                 ItemContainerStyle="{StaticResource SidebarItem}"
                                 HorizontalContentAlignment="Stretch" />

                        <!-- The server list under the sidebar, so a host is one
                             click away from anywhere — the macOS build's
                             sidebar does the same. -->
                        <TextBlock x:Name="ServersHeading"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="18,14,18,4" />
                        <ListBox x:Name="ServerList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="OnServerSelected"
                                 ItemContainerStyle="{StaticResource SidebarItem}"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="7" Height="7"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding StatusBrush}" />
                                        <!-- The sidebar leaves about 190px for
                                             a name, so trimming is the common
                                             case rather than the exception,
                                             and the tooltip is the only way
                                             to read a long one. -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   ToolTip="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoServers"
                                   Style="{StaticResource Text.Tertiary}"
                                   Margin="26,2,18,8"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer: the two things wanted from anywhere. -->
                <StackPanel Grid.Row="2" Margin="10,8,10,10">
                    <Button x:Name="AddServerButton"
                            Style="{StaticResource Button.Accent}"
                            Click="OnAddServer"
                            Margin="0,0,0,6" />
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource Button.Quiet}"
                            Click="OnOpenSettings"
                            HorizontalContentAlignment="Left" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MARK: - Content -->

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- A banner rather than a modal: the app is usable with a scratch
                 store, it just will not remember anything, and a dialog at
                 launch would be dismissed and forgotten. -->
            <Border x:Name="StoreWarning" Grid.Row="0"
                    Background="{DynamicResource Brush.Offline}"
                    Padding="14,8" Visibility="Collapsed">
                <TextBlock x:Name="StoreWarningText"
                           Foreground="White"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Toolbar: title, search, refresh. -->
            <Grid Grid.Row="1" Margin="20,14,20,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PageTitle" Grid.Column="0"
                           Style="{StaticResource Text.Headline}"
                           VerticalAlignment="Center" />
                <TextBox x:Name="Search" Grid.Column="1"
                         Width="220" Margin="0,0,8,0"
                         TextChanged="OnSearchChanged" />
                <Button x:Name="RefreshButton" Grid.Column="2"
                        Style="{StaticResource Button.Quiet}"
                        Click="OnRefresh" />
            </Grid>

            <ContentControl x:Name="PageHost" Grid.Row="2" Margin="0" />
        </Grid>
    </Grid>
</Window>
