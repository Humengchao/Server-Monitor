<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The two controls that need a whole template rather than a few setters.

        A ComboBox and a CheckBox keep their platform chrome unless the
        template is replaced: the default templates paint their own gradients
        and borders and ignore Background and BorderBrush entirely. Setting
        the brushes alone leaves a light-grey Aero picker sitting in a dark
        window — which is exactly what the offscreen render test caught, and
        the reason this file exists.

        Styles.xaml is merged here rather than beside this file in App.xaml
        because the templates below reference its keys with StaticResource,
        and a StaticResource only sees the dictionary it is written in and
        that dictionary's own merges — not a sibling merged alongside it. So
        App.xaml merges this one, and this one brings in Styles.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- MARK: - Picker -->

    <!--
        The arrow, as a path rather than a glyph from a symbol font: Segoe
        Fluent Icons is absent on Windows 10, where the same codepoint in
        Segoe MDL2 is a different shape, and a chevron is eight points.
    -->
    <Geometry x:Key="Geometry.Chevron">M 0,0 L 4,4 L 8,0</Geometry>

    <Style TargetType="ToggleButton" x:Key="Picker.Toggle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!-- Transparent, not null: a null background is not
                         hit-testable, so clicking the middle of the picker
                         would do nothing. -->
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" x:Key="Picker">
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                SnapsToDevicePixels="True" />

                        <!-- The whole surface toggles the popup, so the click
                             target is the control and not just the arrow. -->
                        <ToggleButton Style="{StaticResource Picker.Toggle}"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen,
                                                  RelativeSource={RelativeSource TemplatedParent},
                                                  Mode=TwoWay}" />

                        <ContentPresenter x:Name="PART_ContentSite"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False" />

                        <Path Data="{StaticResource Geometry.Chevron}"
                              Stroke="{DynamicResource Brush.Secondary}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              IsHitTestVisible="False" />

                        <!-- The editable half of a ComboBox template. The
                             pickers here are all read-only, but the part must
                             exist or the template is rejected at load. -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Visibility="Collapsed"
                                 Focusable="False" />

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               VerticalOffset="2"
                               PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{DynamicResource Brush.Background}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="3"
                                    MinWidth="{Binding ActualWidth,
                                               RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <!-- Deliberately opaque: a translucent list
                                     over a card is unreadable, and the popup
                                     is the one surface Mica does not reach. -->
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12"
                                                      ShadowDepth="2"
                                                      Direction="270"
                                                      Opacity="0.25" />
                                </Border.Effect>
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background"
                                    Value="{DynamicResource Brush.CardHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource Picker}" />

    <Style TargetType="ComboBoxItem" x:Key="Picker.Item">
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Surface"
                            Background="Transparent"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Surface" Property="Background"
                                    Value="{DynamicResource Brush.Selection}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background"
                                    Value="{DynamicResource Brush.Selection}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Picker.Item}" />

    <!-- MARK: - Toggle -->

    <Style TargetType="CheckBox" x:Key="Toggle">
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Transparent background across the whole row, so the
                         label is part of the click target rather than only the
                         18px box being. -->
                    <Border Background="Transparent" Padding="0,2">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="4"
                                    Background="{DynamicResource Brush.Card}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Path x:Name="Tick"
                                      Data="M 0,4 L 3.2,7.4 L 9,0.6"
                                      Stroke="White"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter x:Name="Label"
                                              Margin="9,0,0,0"
                                              VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource Text.Control}" />
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Indeterminate is not used by the app, but a
                             CheckBox reaches it from keyboard input if
                             IsThreeState is ever set, and a dash is clearer
                             than an empty box. -->
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Tick" Property="Data" Value="M 0,4 L 9,4" />
                            <Setter TargetName="Tick" Property="Stroke"
                                    Value="{DynamicResource Brush.Secondary}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource Toggle}" />

</ResourceDictionary>
