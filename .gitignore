# Environment
.env

# Build
web/backend/cmd/server/server
*.exe

# IDE
.idea/
.vscode/
*.swp

# Claude Code local settings
.claude/settings.local.json

# Node
web/frontend/node_modules/
web/frontend/dist/

# macOS app (SwiftPM)
macos/.build/
macos/dist/

# Windows app (.NET)
windows/**/bin/
windows/**/obj/
windows/dist/
# Offscreen renders (SM_RENDER_CARDS) and screenshots of the running app. Kept
# out because a screenshot can carry the developer's own SSH key fingerprints
# and comments. Written entry by entry rather than as `windows/artifacts/`,
# because git cannot re-include a file whose parent directory is excluded and
# the soak measurements have to come through: those are columns of numbers,
# they say nothing about the machine that produced them, and the README cites
# them for its handle-growth claim, so a clone needs them.
windows/artifacts/*
!windows/artifacts/*.csv
