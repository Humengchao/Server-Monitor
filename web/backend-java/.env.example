# Server Monitor Java backend configuration.
# The connection string accepts all three forms; they normalize to one JDBC URL:
#   DATABASE_URL=postgres://monitor:secret@localhost:5432/server_monitor?sslmode=disable
#   DATABASE_URL="host=localhost port=5432 user=monitor password=secret dbname=server_monitor sslmode=disable"
#   DATABASE_URL=jdbc:postgresql://localhost:5432/server_monitor
DATABASE_URL=postgres://postgres:your-password@localhost:5432/svrmonitor?sslmode=disable
JWT_SECRET=change-me-to-a-random-string
SERVER_PORT=8080

# Encryption key for SSH credentials at rest (32 bytes, generate with: openssl rand -hex 16)
ENCRYPTION_KEY=6231ed42461fa61b26198cb78be1ba49

# TLS (optional - leave empty to use HTTP)
TLS_CERT_FILE=
TLS_KEY_FILE=

# CORS
CORS_ORIGIN=http://localhost:5173

# Seconds between metrics polls (default 3)
POLL_INTERVAL=3

# Seconds between alert rule evaluations (default 30)
ALERT_INTERVAL=30

# Connection pool size (default 25)
#DATABASE_POOL_MAX=25

# Alert webhooks are blocked from loopback/RFC1918/link-local targets so an
# authenticated user cannot probe the server's private network. Set to true only
# if your notification endpoint lives on the same LAN.
#ALLOW_PRIVATE_WEBHOOKS=false

# Open signup. Enabled by default so existing deployments keep working; set to
# false to close POST /api/auth/register once your accounts exist (returns 403).
#ALLOW_REGISTRATION=true

# Reverse proxies allowed to set X-Forwarded-For, as comma-separated IPs/CIDRs.
# Defaults to loopback + private ranges (fits the docker-compose deployment).
# Set to "none" if clients connect to the backend directly.
#TRUSTED_PROXIES=172.16.0.0/12
